# JobPilot AI - Environment Configuration Template

# Environment & Server
ENVIRONMENT=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Database Configuration
# Default PostgreSQL URL for docker-compose or local PostgreSQL
DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot_pass@localhost:5432/jobpilot_db
# Sync URL for Alembic migrations if needed:
DATABASE_SYNC_URL=postgresql+psycopg://jobpilot:jobpilot_pass@localhost:5432/jobpilot_db

# Storage
STORAGE_DIR=./storage
RESUME_STORAGE_DIR=./storage/resumes
SCREENSHOT_STORAGE_DIR=./storage/screenshots

# AI Provider Configuration
DEFAULT_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3

# Scheduler Configuration
SCHEDULER_ENABLED=false
DISCOVERY_CRON="0 */4 * * *"
DISCOVERY_CONCURRENCY_LIMIT=3

# Browser Automation (Playwright)
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_NAVIGATION_TIMEOUT_MS=30000
REQUIRE_HUMAN_APPROVAL_BEFORE_SUBMISSION=true
JOBPILOT_REAL_SUBMISSION_ENABLED=false
MAX_PRE_SUBMISSION_RETRIES=2
SCREENSHOT_RETENTION_DAYS=7

# Notification Integrations (Optional)
NOTIFICATIONS_LOCAL_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_TO=

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
